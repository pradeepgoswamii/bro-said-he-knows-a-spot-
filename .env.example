# Groq API Key for AI Travel Planner (get yours at https://console.groq.com)
GROQ_API_KEY=""
PORT=3000

# Signing secret for session tokens. Generated automatically on first run if blank.
SESSION_SECRET=

# Signup email verification through Gmail SMTP (no custom domain required).
# Turn on Google 2-Step Verification, create an App Password, then put it here.
GMAIL_USER=youraccount@gmail.com
GMAIL_APP_PASSWORD=


# Optional alternative: Resend requires a verified sender domain for arbitrary recipients.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Know a Spot <auth@your-verified-domain.com>"

# Required MongoDB connection URI. URL-encode reserved characters in credentials.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>
# Optional DNS resolvers for Atlas SRV lookup if the system resolver is unavailable.
MONGODB_DNS_SERVERS=
# Database name (URI database path can also be used if this is left blank).
MONGODB_DB_NAME=know_a_spot
